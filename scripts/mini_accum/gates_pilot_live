#!/usr/bin/env zsh
set -euo pipefail

ROOT="${ROOT:-$HOME/PycharmProjects/Bot_BTC}"
DAY="$(date -u +%F)"
CANARY_DIR="$ROOT/evidence/dayN_${DAY}"

# --- ATTEST (robusto) ---
compute_attest_ok() {
  local LOG="$ROOT/logs/cron.log"
  local STATUS="$ROOT/health/mini_accum.status"
  local last ln body iso day ok
  ok=0

  if [[ -f "$LOG" ]]; then
    last="$(grep -nE '(^\[OK\] write_status:)|(^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*\[OK\] write_status:)' "$LOG" | tail -1)"
    if [[ -n "$last" ]]; then
      ln="${last%%:*}"
      body="$(sed -n "${ln}p" "$LOG")"
      if [[ "$body" != \[* ]]; then
        iso="${body%%[[:space:]]*}"    # 2025-10-28T06:07:00Z
        day="${iso%%T*}"
        [[ "$day" == "$DAY" ]] && ok=1
      fi
    fi
  fi

  if (( ok == 0 )); then
    if [[ -f "$STATUS" ]] && [[ "$(date -u -r "$STATUS" +%F 2>/dev/null)" == "$DAY" ]]; then
      if grep -qE '"health"[[:space:]]*:[[:space:]]*"ok"' "$STATUS" \
         || grep -qE '(^|[[:space:]])health=ok([[:space:]]|$)' "$STATUS" \
         || grep -qE '^health:[[:space:]]*"?ok"?' "$STATUS"; then
        ok=1
      fi
    fi
  fi

  print -r -- "$ok"
}
# --- fin ATTEST ---

# --- GREEN hoy (canario) ---
find_canary_green() {
  local log_path
  if [[ -d "$CANARY_DIR" ]]; then
    log_path="$(ls -1t "$CANARY_DIR"/canary_live.*.log 2>/dev/null | head -1 || true)"
    if [[ -n "$log_path" ]] && grep -qi 'GREEN' "$log_path"; then
      print -r -- "$log_path"; return 0
    fi
  fi
  return 1
}
# --- fin GREEN ---

echo "=== Gates duros ==="

if file_path="$(find_canary_green)"; then
  echo "[OK] Hoy GREEN: $file_path"
else
  echo "[FAIL] Hoy GREEN (no GREEN encontrado en $CANARY_DIR)"
fi

# --- ATTEST desactivado temporalmente ---
echo "[WARN] ATTEST desactivado temporalmente (KISS: solo GREEN bloquea)"
