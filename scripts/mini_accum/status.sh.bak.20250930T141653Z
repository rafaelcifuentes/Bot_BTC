#!/usr/bin/env bash
set -euo pipefail
ROOT="${ROOT:-$HOME/PycharmProjects/Bot_BTC}"
LOG="$ROOT/logs/cron.log"
HEALTH="$ROOT/health/mini_accum.status"
POLICY="$ROOT/reports/mini_accum/policy_asserts_report.json"
FROZEN="$ROOT/reports/mini_accum/code_seal.FROZEN.sha256"

ok()  { printf "✔ %s\n" "$*"; }
warn(){ printf "⚠ %s\n" "$*"; }
fail(){ printf "✖ %s\n" "$*"; }

echo "== STATUS @ $(date -u +%FT%TZ) (UTC) =="

# 1) cron
if pgrep -x cron >/dev/null 2>&1; then ok "cron: activo"; else fail "cron: NO activo"; fi

# 2) VPN claro: default iface + presencia de utun
DEF_IF="$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')"
HAS_UTUN="$(ifconfig 2>/dev/null | grep -E '^utun[0-9]:' -q && echo yes || echo no)"
if [[ "${DEF_IF:-}" =~ ^utun[0-9]+$ ]]; then
  ok "VPN: OK (ruta por ${DEF_IF})"
elif [[ "$HAS_UTUN" == "yes" ]]; then
  ok "VPN: OK (utun presente; default=${DEF_IF:-?})"
else
  warn "VPN: OFF (default=${DEF_IF:-?}; runner/flip-watch se omiten por vpn_guard)"
fi

# 3) caffeinate en crontab (orden indiferente)
C1=$(crontab -l 2>/dev/null | grep -E 'daily_attest_cron\.sh|caffeinate' | grep -E 'daily_attest_cron\.sh|caffeinate' | grep -c caffeinate || true)
C2=$(crontab -l 2>/dev/null | grep -E 'weekly_runner\.sh|caffeinate'   | grep -E 'weekly_runner\.sh|caffeinate'   | grep -c caffeinate || true)
C3=$(crontab -l 2>/dev/null | grep -E 'weekly_reserve_pack_cron\.sh|caffeinate' | grep -E 'weekly_reserve_pack_cron\.sh|caffeinate' | grep -c caffeinate || true)
[[ "$C1" -gt 0 ]] && ok "cron: caffeinate (daily_attest)" || fail "cron: sin caffeinate (daily_attest)"
[[ "$C2" -gt 0 ]] && ok "cron: caffeinate (weekly_runner)" || fail "cron: sin caffeinate (weekly_runner)"
[[ "$C3" -gt 0 ]] && ok "cron: caffeinate (reserve_pack)"  || fail "cron: sin caffeinate (reserve_pack)"

# 4) vpn_guard presente en runner/flip-watch (acepta wrapper)
if crontab -l 2>/dev/null | grep -q 'runner_cron\.sh'; then
  if grep -q 'vpn_guard\.sh' "$ROOT/scripts/mini_accum/runner_cron.sh"; then
    ok "cron: vpn_guard → weekly_runner (via runner_cron.sh)"
  else
    warn "cron: runner_cron.sh sin vpn_guard dentro"
  fi
else
  VG1=$(crontab -l 2>/dev/null | grep -c 'vpn_guard\.sh.*weekly_runner\|weekly_runner.*vpn_guard\.sh' || true)
  [[ "$VG1" -gt 0 ]] && ok "cron: vpn_guard → weekly_runner" || fail "cron: sin vpn_guard → weekly_runner"
fi
VG2=$(crontab -l 2>/dev/null | grep -c 'vpn_guard\.sh.*flip_watch\|flip_watch.*vpn_guard\.sh'     || true)
[[ "$VG2" -gt 0 ]] && ok "cron: vpn_guard → flip_watch"    || warn "cron: sin vpn_guard → flip_watch"

# 5) Policy asserts
if [ -s "$POLICY" ]; then
  PS=$(python3 - <<PY 2>/dev/null
import json; print(json.load(open("$POLICY")).get("status","?"))
PY
  )
  [[ "$PS" == "OK" ]] && ok "policy_asserts: OK" || fail "policy_asserts: $PS"
else
  warn "policy_asserts: sin reporte"
fi

# 6) CODE SEAL FROZEN
if [ -f "$FROZEN" ]; then
  if ( cd "$ROOT" && shasum -a 256 -c "$FROZEN" >/dev/null 2>&1 ); then
    ok "CODE SEAL FROZEN: OK"
  else
    fail "CODE SEAL FROZEN: MISMATCH"
  fi
else
  warn "CODE SEAL FROZEN: no existe"
fi

# 7) Health
if [ -s "$HEALTH" ]; then
  echo -n "health: "; tail -n1 "$HEALTH"
else
  warn "health: sin fichero"
fi

# 8) Último ATTEST
if [ -s "$LOG" ]; then
  echo "-- cron.log (últimos ATTEST) --"
  grep -E 'daily_attest: start|ATTEST START|ATTESTATION:' "$LOG" | tail -n 6 || true
else
  warn "cron.log: no encontrado"
fi

ROOT="$HOME/PycharmProjects/Bot_BTC"
FILE="$ROOT/scripts/mini_accum/status.sh"

awk '
BEGIN{inblk=0}
# Entramos al bloque 9
# 9) Runner último: huella en cron.log (fallback runner.*)
LAST=$(grep -E 'weekly_runner: (LOG_LEVEL|done)' "$LOG" | tail -n 1 || true)
if [ -n "$LAST" ]; then
  if echo "$LAST" | grep -q done; then
    ok "runner: DONE ("$(echo "$LAST" | cut -d" " -f1)")"
  else
    warn "runner: sin 'done' (última: $LAST)"
  fi
else
  RUNLOG=""
  while read -r f; do [ -s "$f" ] && { RUNLOG="$f"; break; }; done < <(ls -1t "$ROOT/logs"/runner.*.log 2>/dev/null || true)
  if [ -n "$RUNLOG" ]; then
    if grep -q 'weekly_runner: done' "$RUNLOG" 2>/dev/null; then
      ok "runner último: DONE ("$(basename "$RUNLOG")")"
    else
      warn "runner último: sin 'done' ("$(basename "$RUNLOG")")"
    fi
  else
    warn "runner: sin huellas"
  fi
fi
# 10) Reserve packs
CNT=$(ls -1 "$ROOT/reports/mini_accum"/reserve_pack.*.tgz 2>/dev/null | wc -l | tr -d ' ')
if [ "$CNT" -gt 0 ]; then
  LAST=$(ls -1t "$ROOT/reports/mini_accum"/reserve_pack.*.tgz | head -1)
  ok "reserve packs: $CNT (último: $(basename "$LAST"))"
else
  warn "reserve packs: ninguno"
fi

# 11) Próximas ventanas (UTC)
python3 - <<'PY'
from datetime import datetime, timedelta, timezone
now = datetime.now(timezone.utc)
def nxt(h,m,w=None):
    t=now.replace(hour=h, minute=m, second=0, microsecond=0)
    if t<=now: t+=timedelta(days=1)
    if w is None: return t
    while t.weekday() not in w: t+=timedelta(days=1)
    return t
fmt=lambda d:d.strftime("%Y-%m-%d %H:%M UTC (%a)")
print("-- Próximas ventanas --")
print("Attest diario 07:58 ->", fmt(nxt(7,58)))
print("Runner Diario 08:05 ->", fmt(nxt(8,5)))
print("Watchdog Diario 08:20 ->", fmt(nxt(8,20)))
print("KPI guard Diario 08:25 ->", fmt(nxt(8,25)))
print("Reserve pack Jue 08:35 ->", fmt(nxt(8,35,[3])))
print("Limpieza packs Jue 08:45 ->", fmt(nxt(8,45,[3])))
PY

# --- Dashboard simple (opcional) ---
if [ -z "${NO_DASHBOARD:-}" ]; then
  ROOT="${ROOT:-$HOME/PycharmProjects/Bot_BTC}"
  python3 - "$ROOT" <<'PY'
import json, os, datetime
root = os.sys.argv[1]

def rj(p):
    try:
        with open(p, 'r', encoding='utf-8') as f: return json.load(f)
    except Exception: return {}

# Estado
latest = rj(os.path.join(root, 'signals', 'mini_accum', 'latest.json'))
estado = (latest.get('health') or latest.get('status') or 'n/a')
ts     = latest.get('ts_utc') or 'n/a'
pos    = latest.get('position_pct_btc')

# NetBTC vs HODL
perf = rj(os.path.join(root, 'reports', 'mini_accum', 'perf_seal.json'))
def pick(d,*k):
    for x in k:
        if x in d: return d[x]
    return None
netbtc = pick(perf,'net_btc','netbtc','NetBTC','netBTC')
hodl   = pick(perf,'hodl_btc','HODL_BTC','hodl')

# Flips 7d (cron.log, robusto)
flips_7 = 0; fpy = None
try:
    cron = os.path.join(root, 'logs', 'cron.log')
    now = datetime.datetime.utcnow()
    cutoff = now - datetime.timedelta(days=7)
    with open(cron, 'r', encoding='utf-8') as f:
        for line in f:
            if 'flip' not in line.lower():
                continue
            # Timestamp al inicio tipo 2025-09-30T13:32:19Z
            ts = line.split('Z',1)[0]
            try:
                dt = datetime.datetime.strptime(ts, '%Y-%m-%dT%H:%M:%S')
                if dt >= cutoff:
                    flips_7 += 1
            except Exception:
                pass
    fpy = round(flips_7 * 365.0 / 7.0, 2)
except Exception:
    pass

print("")
print("-- Dashboard simple --")
print(f"Estado: {estado} @ {ts}")
print(f"Posición BTC: {pos:.4f}" if isinstance(pos,(int,float)) else "Posición BTC: n/a")
if isinstance(netbtc,(int,float)) and isinstance(hodl,(int,float)):
    diff = netbtc - hodl
    print(f"NetBTC vs HODL: {netbtc:.6f} vs {hodl:.6f} (Δ={diff:+.6f})")
else:
    print("NetBTC vs HODL: n/a (esperando perf_seal.json)")
print(f"Flips 7d: {flips_7}  |  FPY≈ {fpy}" if fpy is not None else "FPY: n/a")
PY
fi
