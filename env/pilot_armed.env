export ROOT="$HOME/PycharmProjects/Bot_BTC"

# Guardarraíl exige 'binance'. En ARMED no se envían órdenes.
export EXCHANGE="binance"

# ARMED: ejercita la ruta de trading sin enviar órdenes reales
export DO_TRADE=1
export DRYRUN=0
export ORDER_MODE="ARMED"

# Límite micro y cap (por si el código los loguea)
export USD_MAX=10
export CAP=0.10

# Marcha por defecto en H2-2025: M2 (CORE_2025)
export PRESET_ACTIVE="$ROOT/configs/mini_accum/presets/CORE_2025.yaml"

# Guards (no cambiamos nada)
export LOG_LEVEL=INFO
