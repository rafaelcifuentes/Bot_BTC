#!/usr/bin/env bash
set -Eeuo pipefail
CHANGED=$(git diff --cached --name-only --diff-filter=ACMRT | grep -E '\.ya?ml$' || true)
[ -z "$CHANGED" ] && exit 0
ok=1
for f in $CHANGED; do
  if ! yq -e '.' "$f" >/dev/null 2>&1; then
    echo "❌ YAML inválido: $f"; ok=0; continue
  fi
  if ggrep -n -E '^#!|<<..PY|^\s*def\s|^\s*import\s' "$f" >/dev/null 2>&1; then
    echo "❌ Posible código no-YAML en: $f"; ok=0; continue
  fi
done
[ $ok -eq 1 ] || exit 1
# --- README git-transcript guard ---
if [[ -f README.md ]] && grep -Eq '^(Enumerating objects|Counting objects|Delta compression using|Compressing objects|Writing objects|Total [0-9]|remote: Resolving deltas|To github\.com:)' README.md; then
  echo "[pre-commit] README contiene salida de git/terminal. Límpialo antes de commitear."
  exit 1
fi
# --- END ---
